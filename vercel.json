{
  "redirects": [
    { "source": "/", "destination": "/toronto.html", "permanent": false },
    { "source": "/index.html", "destination": "/toronto.html", "permanent": false },
    { "source": "/index", "destination": "/toronto.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
